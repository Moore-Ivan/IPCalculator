# 统一文本文件行尾为 LF，保证 ubuntu/windows CI 构建一致，避免行尾噪声 diff
* text=auto eol=lf

# 二进制文件不做行尾转换
*.ico  binary
*.icns binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.bmp  binary
*.jar  binary
*.zip  binary
*.gz   binary
*.dll  binary
*.exe  binary
*.msi  binary

# Gradle Wrapper 启动脚本必须是 LF 且可执行
gradlew     text eol=lf
gradlew.bat text eol=crlf
